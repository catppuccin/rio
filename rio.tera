---
whiskers:
  version: "^2.9.0"
  matrix:
    - flavor
  filename: "themes/catppuccin-{{ flavor.identifier }}.toml"
  hex_format: "#{{r}}{{g}}{{b}}{{z}}"
---
{#- ANSI black/white per the Catppuccin style guide. Latte is the dark
    mapping with the black and white ramps swapped, so that ANSI black
    stays dark (readable) on a light background. -#}
{%- if flavor.dark -%}
{%- set ansi_black_dim = surface0 -%}
{%- set ansi_black = surface1 -%}
{%- set ansi_black_bright = surface2 -%}
{%- set ansi_white_dim = overlay1 -%}
{%- set ansi_white = subtext0 -%}
{%- set ansi_white_bright = subtext1 -%}
{%- else -%}
{%- set ansi_black_dim = overlay1 -%}
{%- set ansi_black = subtext1 -%}
{%- set ansi_black_bright = subtext0 -%}
{%- set ansi_white_dim = surface0 -%}
{%- set ansi_white = surface2 -%}
{%- set ansi_white_bright = surface1 -%}
{%- endif -%}
[colors]

# Normal
foreground       = '{{ text.hex }}'
background       = '{{ base.hex }}'
black            = '{{ ansi_black.hex }}'
blue             = '{{ blue.hex }}'
cyan             = '{{ teal.hex }}'
green            = '{{ green.hex }}'
magenta          = '{{ pink.hex }}'
red              = '{{ red.hex }}'
white            = '{{ ansi_white.hex }}'
yellow           = '{{ yellow.hex }}'

# Cursor
cursor           = '{{ rosewater.hex }}'
vi-cursor        = '{{ lavender.hex }}'

# UI colors
# `tabs` and `tabs-active` are tab *title* colors; Rio derives the tab
# island backgrounds from the window background automatically.
tabs             = '{{ subtext0.hex }}'
tabs-active      = '{{ text.hex }}'
split            = '{{ overlay0.hex }}'
split-active     = '{{ lavender.hex }}'

# Selection
selection-foreground   = '{{ base.hex }}'
selection-background   = '{{ rosewater.hex }}'

# Search
search-match-foreground         = '{{ base.hex }}'
search-match-background         = '{{ subtext0.hex }}'
search-focused-match-foreground = '{{ base.hex }}'
search-focused-match-background = '{{ green.hex }}'

# Hints
hint-foreground  = '{{ base.hex }}'
hint-background  = '{{ yellow.hex }}'

# Dim colors
dim-black        = '{{ ansi_black_dim.hex }}'
dim-blue         = '{{ blue.hex }}'
dim-cyan         = '{{ teal.hex }}'
dim-foreground   = '{{ overlay2.hex }}'
dim-green        = '{{ green.hex }}'
dim-magenta      = '{{ pink.hex }}'
dim-red          = '{{ red.hex }}'
dim-white        = '{{ ansi_white_dim.hex }}'
dim-yellow       = '{{ yellow.hex }}'

# Light colors
light-black      = '{{ ansi_black_bright.hex }}'
light-blue       = '{{ blue.hex }}'
light-cyan       = '{{ teal.hex }}'
light-foreground = '{{ text.hex }}'
light-green      = '{{ green.hex }}'
light-magenta    = '{{ pink.hex }}'
light-red        = '{{ red.hex }}'
light-white      = '{{ ansi_white_bright.hex }}'
light-yellow     = '{{ yellow.hex }}'
